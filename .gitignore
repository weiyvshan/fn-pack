# Workspace scratch and local build caches
/.tmp/
/build/
/vendor/
/evidence/
**/.tmp/

# Keep only the empty credential directory placeholder in source control.
/apps/sub2api/app/docker/runtime-secrets/*
!/apps/sub2api/app/docker/runtime-secrets/.keep

# Archived hand-deployed instances hold runtime keys and private backups;
# archived FPK bodies are superseded releases. Neither belongs in history.
/archive/*/deploy-*/
/archive/**/*.fpk
**/node_modules/
**/.cache/
**/coverage/
**/.pytest_cache/
**/__pycache__/
**/*.tsbuildinfo
**/*.py[cod]

# Local environment files; keep shareable examples
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating-system residue
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# The Windows sandbox ACL diagnostic writes its repair records here.
# They are per-run artifacts and are recreated by the next diagnosis.
/.acl-recovery/
