#!/bin/bash
FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

all_containers_running() {
    for name in sub2api sub2api-postgres sub2api-redis; do
        state="$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" || return 1
        [ "$state" = "true" ] || return 1
    done
}

is_docker_running () {
    DOCKER_NAME=""
    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(cat $FILE_PATH | grep "container_name" | awk -F ':' '{print $2}' | xargs)
    fi
    if [ -n "$DOCKER_NAME" ]; then
        docker inspect $DOCKER_NAME | grep -q "\"Status\": \"running\"," || exit 1
        return
    fi
}

case $1 in
start) exit 0 ;;
stop) exit 0 ;;
status) if all_containers_running; then exit 0; else exit 3; fi ;;
*) exit 1 ;;
esac
