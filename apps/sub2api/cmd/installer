#!/bin/bash

INST_LOG="/var/log/apps/${TRIM_APPNAME}.log"
TMP_DIR="${TRIM_TEMP_UPGRADE_FOLDER}"

COMMON="$(dirname "$0")/common"
echo "${COMMON}"
if [ -r "${COMMON}" ]; then
    . "${COMMON}"
fi

SVC_SETUP="$(dirname "$0")/service-setup"
echo "${SVC_SETUP}"
if [ -r "${SVC_SETUP}" ]; then
    . "${SVC_SETUP}"
fi

run_phase() {
    local phase="$1"
    local log_file="${TRIM_TEMP_LOGFILE:?}"
    local capture_file="${log_file}.phase.$$"
    local phase_status

    case "$phase" in
        install_init|install_callback|upgrade_init|upgrade_callback|\
        config_init|config_callback|uninstall_init|uninstall_callback)
            ;;
        *)
            printf '%s\n' "Unsupported lifecycle phase: $phase" > "$log_file"
            return 1
            ;;
    esac

    umask 077
    : > "$log_file" || return 1
    if ! : > "$capture_file"; then
        printf '%s\n' 'Cannot create the lifecycle output capture file.' > "$log_file"
        return 1
    fi

    if ("$phase") > "$capture_file" 2>&1; then
        phase_status=0
    else
        phase_status=$?
    fi

    if [ -s "$capture_file" ]; then
        if ! cat "$capture_file" >> "$log_file"; then
            [ "$phase_status" -ne 0 ] || phase_status=1
        fi
    fi
    rm -f -- "$capture_file"
    return "$phase_status"
}

load_variables_from_file "${INST_VARIABLES}"
call_func "initialize_variables" install_log || exit $?
