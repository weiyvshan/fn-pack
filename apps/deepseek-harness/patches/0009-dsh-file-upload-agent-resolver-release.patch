@@ -0,0 +1,46 @@
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import FileUploads from '../src/index.ts'
+
+/** Minimal Host services the upload service reads while it is constructed. */
+function uploadContext(): Context {
+  const ctx = new Context()
+  ctx.provide('agents', { get: () => undefined } as never)
+  ctx.provide('attachments', {} as never)
+  ctx.provide('commands', { registerFileReceiptResolver: () => () => {} } as never)
+  ctx.provide('connection', { fetch: { register: () => () => {} } } as never)
+  return ctx
+}
+
+describe('file upload Agent resolver registration', () => {
+  it('releases the registration when the resolver owner is disposed', async () => {
+    const ctx = uploadContext()
+    await ctx.plugin(FileUploads)
+    // The Host resolves the service through the context, so the disposer sees
+    // the service the way the Session Controller does.
+    const uploads = ctx.fileUploads
+    const resolver = async () => { throw new Error('the test never resolves an Agent') }
+
+    const dispose = uploads.registerAgentResolver(resolver)
+    expect(() => { uploads.registerAgentResolver(resolver) }).toThrow('already registered')
+
+    dispose()
+    expect(() => { uploads.registerAgentResolver(resolver) }).not.toThrow()
+  })
+
+  it('keeps a newer registration when an older disposer runs late', async () => {
+    const ctx = uploadContext()
+    await ctx.plugin(FileUploads)
+    const uploads = ctx.fileUploads
+    const first = async () => { throw new Error('the test never resolves an Agent') }
+    const second = async () => { throw new Error('the test never resolves an Agent') }
+
+    const disposeFirst = uploads.registerAgentResolver(first)
+    disposeFirst()
+    const disposeSecond = uploads.registerAgentResolver(second)
+
+    disposeFirst()
+    expect(() => { uploads.registerAgentResolver(second) }).toThrow('already registered')
+    disposeSecond()
+  })
+})
