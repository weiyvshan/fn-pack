+/** Atomically publish the launch token without exposing its authenticated URL. */
+function publishManagedLaunchToken(destination: string, authenticatedUrl: string): void {
+  if (destination === '' || !isAbsolute(destination)) {
+    throw new Error(`${DSH_WEB_AUTH_TOKEN_FILE} must name an absolute file path`)
+  }
+  const url = new URL(authenticatedUrl)
+  const tokens = url.searchParams.getAll('token')
+  const token = tokens[0]
+  if (tokens.length !== 1 || token === undefined || !/^[A-Za-z0-9_-]+$/u.test(token)) {
+    throw new Error('web-app: Connection returned an invalid browser launch token')
+  }
+  const temporary = `${destination}.${String(process.pid)}.${randomBytes(8).toString('hex')}.tmp`
+  try {
+    writeFileSync(temporary, `${token}\n`, { encoding: 'utf8', flag: 'wx', mode: 0o600 })
+    renameSync(temporary, destination)
+  } finally {
+    rmSync(temporary, { force: true })
+  }
+}
