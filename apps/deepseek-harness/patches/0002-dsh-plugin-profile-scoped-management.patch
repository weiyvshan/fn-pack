+/** Open Linux descriptors that still point into one fixture tree. */
+function openDescriptorsBelow(root: string): string[] {
+  const descriptorRoot = '/proc/self/fd'
+  if (!existsSync(descriptorRoot)) return []
+  const prefix = `${resolve(root)}/`
+  return readdirSync(descriptorRoot).flatMap((descriptor) => {
+    try {
+      const target = readlinkSync(join(descriptorRoot, descriptor)).replace(/ \(deleted\)$/, '')
+      return target.startsWith(prefix) ? [target] : []
+    } catch { return [] }
+  })
+}
